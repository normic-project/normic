# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
MCP_PORT=3100
MCP_HOST=127.0.0.1
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGIN_HOSTS=
NORMIC_PUBLIC_ORIGIN=http://127.0.0.1:3100
# Public Streamable HTTP endpoint shown on /connect. Required and HTTPS in production.
NORMIC_REMOTE_MCP_URL=http://127.0.0.1:3100/mcp
NORMIC_RATE_LIMIT_PER_MINUTE=120

# Development-only MCP opaque credential verifier. REST supports scoped API credentials.
NORMIC_DEV_AUTH_ENABLED=true
NORMIC_AUTH_ISSUER=http://127.0.0.1:3100/dev-auth
NORMIC_AUTH_AUDIENCE=http://127.0.0.1:3100/mcp
# Supabase production values:
# issuer: https://<project-ref>.supabase.co/auth/v1
# audience: the exact NORMIC_REMOTE_MCP_URL, set by a Custom Access Token Hook
# JWKS: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# OAuth tokens must add server-controlled normic_agent_id,
# normic_credential_id, normic_scopes, and email_verified claims.
NORMIC_AUTH_JWKS_URL=
# Production onboarding verifies the standard owner token and confirms email state against Supabase auth.users.
NORMIC_OWNER_AUTH_ISSUER=
NORMIC_OWNER_AUTH_AUDIENCE=authenticated
NORMIC_OWNER_AUTH_JWKS_URL=

# PostgreSQL is mandatory in production, and for concurrent web + MCP local processes.
# PGlite requires an explicit NODE_ENV=development/test. Use only one runtime process per directory.
DATABASE_URL=
PGLITE_DATA_DIR=.data/local-phase3

# The current product network. Financial and trading execution remain fail-closed
# until their independent Phase 4/5 production controls are fully configured.
NORMIC_NETWORK=robinhood-mainnet
ROBINHOOD_MAINNET_ENABLED=true
# Production must configure a dedicated provider URL. The public RPC is development-only.
ROBINHOOD_RPC_URL=
ROBINHOOD_MARKET_API_URL=https://api.robinhood.com/rhj

# Phase 4: no execution without a real verified deployment. No default money limits.
NORMIC_FINANCIAL_EXECUTION_ENABLED=false
# Human deployment approval gates. Keep false until explicitly authorized.
NORMIC_OWNER_FINANCIAL_AUTHORIZATION_ENABLED=false
NORMIC_AUTONOMOUS_FINANCIAL_EXECUTION_ENABLED=false
# Names/references for a reviewed custody/session implementation. Never store raw keys here.
NORMIC_CUSTODY_PROVIDER=
NORMIC_CUSTODY_CREDENTIAL_REF=
ALCHEMY_API_KEY=
NORMIC_ESCROW_ADDRESS=
NORMIC_ESCROW_RUNTIME_HASH=
NORMIC_ESCROW_DEPLOYMENT_BLOCK=
MAX_SERVICE_PAYMENT_USDG=
ADMIN_ADDRESS=
DISPUTE_RESOLVER_ADDRESS=
ADMIN_DELAY_SECONDS=
DEPLOYER_ADDRESS=
# Secure signer JSON-RPC endpoint; never put a raw owner/deployer key here.
DEPLOYER_RPC_URL=
NORMIC_ACCEPT_TIMEOUT_SECONDS=3600
NORMIC_COMPLETION_TIMEOUT_SECONDS=86400
NORMIC_REVIEW_WINDOW_SECONDS=86400
# Autonomous signing additionally requires the reviewed SessionCustodian integration.
# Gas sponsorship is not enabled. Smart wallets need real ETH for gas.

# Phase 5 Stock Token execution. Every field is fail-closed; there are no
# development defaults and no production mock fallback.
NORMIC_TRADING_EXECUTION_ENABLED=false
# Names/references for the reviewed production eligibility integration.
NORMIC_ELIGIBILITY_PROVIDER=
NORMIC_ELIGIBILITY_CREDENTIAL_REF=
ZEROX_API_KEY=
# Comma-separated, independently verified Robinhood Chain addresses returned by
# the configured 0x AllowanceHolder endpoint. Never copy addresses from a quote
# into this allowlist automatically.
NORMIC_TRADING_ALLOWED_TARGETS=
NORMIC_TRADING_ALLOWED_SPENDERS=
# Exact 0x route source names reviewed by the deployment owner/admin.
NORMIC_TRADING_ALLOWED_SOURCES=
NORMIC_TRADING_VENUE_CONFIG_VERSION=
NORMIC_QUOTE_TTL_SECONDS=15
# JSON: {"version":"...","source":"https://docs.chain.link/...","feeds":{"0x<asset-uid>":{"address":"0x...","heartbeatSeconds":60}}}
NORMIC_STOCK_ORACLE_CONFIG_JSON=
NORMIC_SEQUENCER_UPTIME_FEED=
NORMIC_SEQUENCER_GRACE_SECONDS=3600
# A reviewed production EligibilityProvider and TradingSessionCustodian must be
# integrated in deployment code. Their secrets and session private keys are not env fields.
